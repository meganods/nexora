rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────────

    // Check if the current user is an Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'urbanadmin01@gmail.com' ||
        request.auth.token.email == 'admin@gmail.com' ||
        request.auth.token.email == 'meganodscare@gmail.com' ||
        request.auth.token.email.matches('(?i).*admin.*')
      );
    }

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if user owns the document (by userId field)
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ─── User Collections ─────────────────────────────────────────────────────

    // User profiles — users can read/write their own; admin has full access
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isAuth() && (
          request.auth.uid == userId ||
          request.auth.token.email == userId
        )
      );
    }

    // User addresses
    match /addresses/{addressId} {
      allow read, write: if isAdmin() || isAuth();
    }

    // ─── Services & Professionals ─────────────────────────────────────────────

    // Vendors / professionals
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Services catalog (browsable by all)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Category requests submitted by vendors
    match /category_requests/{requestId} {
      allow read, write: if isAuth();
    }

    // ─── Bookings ─────────────────────────────────────────────────────────────

    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false; // Never delete — only cancel (soft delete)
    }

    // Booking timeline/status updates
    match /booking_timeline/{timelineId} {
      allow read, write: if true;
    }

    // ─── Reviews & Ratings ────────────────────────────────────────────────────

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAdmin() || (isAuth() && request.auth.uid == resource.data.userId);
    }

    // ─── Admin ────────────────────────────────────────────────────────────────

    match /admins/{adminId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == adminId);
      allow write: if false; // Must be added manually via Firebase Console
    }

    // ─── Offers & Coupons ─────────────────────────────────────────────────────

    // Coupons (Active coupon list — visible to logged-in users)
    match /coupons/{couponId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Flash offers (special limited-time deals added by admin)
    match /flash_offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupon usage/redemption tracking
    match /coupon_usage/{usageId} {
      allow read, create: if isAuth() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /coupon_redemptions/{redemptionId} {
      allow read, create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ─── Campaigns & Promotions ───────────────────────────────────────────────

    // Admin-run campaigns
    match /campaigns/{campaignId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Vendor-submitted campaign requests
    match /vendor_campaigns/{campaignId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin() || (
        isAuth() && resource.data.vendorEmail == request.auth.token.email
      );
      allow delete: if isAdmin();
    }

    // ─── Notifications ────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read, write: if isAuth();
    }

    // ─── User Activity & History ──────────────────────────────────────────────

    // Recently viewed services (per-user cache)
    match /recently_viewed/{viewId} {
      allow read, write: if isAuth();
    }

    // Search history (user search queries)
    match /search_history/{searchId} {
      allow read, write: if isAuth();
    }

    // User favorites / wishlist
    match /favorites/{favId} {
      allow read, write: if isAuth();
    }

    // ─── Wallet & Payments ────────────────────────────────────────────────────

    // Wallet balances (users can read their own; admin has full access)
    match /wallet/{walletId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == walletId);
      allow write: if isAdmin() || (isAuth() && request.auth.uid == walletId);
    }

    // Wallets collection (alternate collection name used in nexora_ai_assistant_screen)
    match /wallets/{walletId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == walletId);
      allow write: if isAdmin() || (isAuth() && request.auth.uid == walletId);
    }

    // Transactions log (payments, refunds, rewards)
    match /transactions/{txId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // Payment receipts
    match /payment_receipts/{receiptId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ─── Misc Platform ────────────────────────────────────────────────────────

    // App configuration / platform settings
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Vendor earnings (vendor-visible only + admin)
    match /vendor_earnings/{earnId} {
      allow read: if isAdmin() || isAuth();
      allow write: if isAdmin();
    }

    // Referrals
    match /referrals/{refId} {
      allow read, write: if isAuth();
    }

    // ─── Default Catch-All ────────────────────────────────────────────────────

    // Deny all other documents by default (security-first approach)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
