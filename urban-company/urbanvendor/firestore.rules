rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin.example@gmail.com' ||
        request.auth.token.email == 'urbanadmin01@gmail.com' ||
        request.auth.token.email == 'admin@gmail.com' ||
        request.auth.token.email == 'meganodscare@gmail.com' ||
        request.auth.token.email.matches('(?i).*admin.*')
      );
    }

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // ─── Real-Time Chat System ────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ─── User Accounts & Addresses ────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /addresses/{addressId} {
      allow read, write: if true;
    }

    // ─── Vendors & Services Catalog ───────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if true;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /category_requests/{requestId} {
      allow read, write: if true;
    }

    // ─── Bookings & Timeline ──────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read, create, update: if true;
      allow delete: if false; // Never hard delete bookings — only update status to cancelled
    }

    match /booking_timeline/{timelineId} {
      allow read, write: if true;
    }

    // ─── Real-Time Invoices ───────────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // ─── Reviews & Ratings ────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // ─── Admin Management ─────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // ─── Offers, Coupons & Promotions ─────────────────────────────────────────
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /flash_offers/{offerId} {
      allow read, write: if true;
    }

    match /coupon_usage/{usageId} {
      allow read, write: if true;
    }

    match /coupon_redemptions/{redemptionId} {
      allow read, write: if true;
    }

    match /campaigns/{campaignId} {
      allow read, write: if true;
    }

    match /vendor_campaigns/{campaignId} {
      allow read, write: if true;
    }

    // ─── Real-Time Notifications ──────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // ─── User Activity & History ──────────────────────────────────────────────
    match /recently_viewed/{viewId} {
      allow read, write: if true;
    }

    match /search_history/{searchId} {
      allow read, write: if true;
    }

    match /favorites/{favId} {
      allow read, write: if true;
    }

    // ─── Wallet & Payments ────────────────────────────────────────────────────
    match /wallet/{walletId} {
      allow read, write: if true;
    }

    match /wallets/{walletId} {
      allow read, write: if true;
    }

    match /transactions/{txId} {
      allow read, write: if true;
    }

    match /payment_receipts/{receiptId} {
      allow read, write: if true;
    }

    // ─── Platform & Earnings ──────────────────────────────────────────────────
    match /app_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    match /vendor_earnings/{earnId} {
      allow read, write: if true;
    }

    match /referrals/{refId} {
      allow read, write: if true;
    }

    // ─── Catch-All Document Match ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
